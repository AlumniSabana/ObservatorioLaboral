# Variables de entorno del backend. Copia este archivo como `.env` en esta misma
# carpeta (src/backend/.env) y rellena los valores. El `.env` real NO se
# versiona (ver .gitignore); esta plantilla sí, para saber qué hace falta.
#
# Las lee config.py (servicios externos) y auth.py (acceso de Administrador).
# Las que tienen valor aquí son valores por defecto u opcionales.

# --- Supabase (base de datos) -----------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Adzuna (vacantes de EE.UU., Reino Unido, Canadá, México y España) --------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- SerpApi (Google Jobs, Colombia) ----------------------------------------
SERPAPI_KEY=
# Presupuesto de búsquedas por corrida (cada página = 1 búsqueda). El plan
# gratuito da ~250/mes. Opcional; 240 por defecto.
SERPAPI_MAX_BUSQUEDAS=240

# --- Modelos de lenguaje ------------------------------------------------------
# Claude (Anthropic): lector de documentos del backend. Puede ser la misma key
# que usa el chat del frontend (CLAUDE_API_KEY en .env.local de la raíz).
ANTHROPIC_API_KEY=
# Gemini (Google): informe de insights (Informes/insights_service.py).
GEMINI_API_KEY=

# --- O*NET Web Services (sección "Competencias y habilidades") ---------------
# Registro gratuito: https://services.onetcenter.org/developer/signup
ONET_API_KEY=

# --- Google Document AI (OCR de informes PDF escaneados) ---------------------
# Opcional: sin esto el extractor usa pypdf (bien para PDFs nativos, no para
# escaneos). Ver el comentario en config.py para configurarlo.
GCP_PROJECT_ID=
GCP_LOCATION=us
DOCAI_PROCESSOR=
GOOGLE_APPLICATION_CREDENTIALS=

# --- LinkedIn (solo ofertas públicas; requiere aprobación institucional) ------
# Ver el interruptor y su porqué en config.py. false = infraestructura apagada.
LINKEDIN_HABILITADO=false
LINKEDIN_MAX_PAGINAS=3
LINKEDIN_PAUSA_SEG=3

# --- Acceso de Administrador (auth.py) ---------------------------------------
# CREDENCIALES DE PRUEBA: el usuario autorizó dejarlas en claro en esta
# plantilla. En producción cámbialas en el `.env` real, nunca aquí.
ADMIN_EMAIL=alumni@unisabana.edu.co
ADMIN_PASSWORD=Alu_mni26@*
# Clave con la que se firman los tokens de sesión. Cadena aleatoria larga, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Si falta, el backend genera una por proceso y las sesiones de Admin caducan
# cada vez que se reinicia (lo avisa por consola al arrancar).
AUTH_SECRET=
