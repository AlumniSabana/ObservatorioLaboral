# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.local
.env.local

# database structure
*.sql
# …pero las migraciones SÍ van al repo: son el esquema de la base y sin ellas
# el proyecto no se puede levantar desde cero.
!src/backend/migrations/*.sql

# Fuentes externas grandes: los ETL las descargan solas (ver la URL en cada
# cargar_*.py). La Base IBC del OLE pesa 48 MB y no tiene por qué vivir en Git.
src/backend/OLE/data/*.xlsx

# pdfs de prueba
*.pdf

# Cachés en disco que el backend regenera solo (ver comentarios junto a cada
# CACHE_*_PATH en el código). Versionarlos genera ruido en cada regeneración
# local y, peor, puede servir datos obsoletos en producción si el deploy trae
# una versión vieja committeada en vez de recalcularla.
src/backend/Tendencias/_cache_onet.json
src/backend/Tendencias/_cache_opciones.json
src/backend/ONet/_cache_perfil_onet.json